---
import Base from '../layouts/Base.astro';
import '../styles/article.css';
---
<Base title="empty layer" description="Nothing at this address.">
  <main class="art" id="content">
    <header class="art-head">
      <div><span class="tag off">404</span><span class="mono">empty layer</span></div>
      <h1>Nothing shipped on this layer.</h1>
      <p class="dek">The address resolves to a part that was never built.</p>
    </header>
    <p class="mono"><a class="go" href="/">← back to sheet 00</a></p>
  </main>
</Base>
