---
const PK = ['i1', 'i2'];
---
<svg viewBox="0 0 680 440" fill="none" font-family="Martian Mono, monospace" font-size="11" aria-hidden="true">
        <defs><marker id="arI" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L8 4L0 8" stroke="var(--line)" stroke-width="1.2"/></marker></defs>
        <g stroke="var(--line)" stroke-width="1.1" stroke-dasharray="5 4">
          <rect x="20" y="90" width="250" height="250"/>
          <rect x="44" y="140" width="96" height="44"/><rect x="152" y="140" width="96" height="44"/>
          <rect x="44" y="196" width="96" height="44"/><rect x="152" y="196" width="96" height="44"/>
          <rect x="44" y="252" width="204" height="44"/>
          <circle cx="370" cy="215" r="34"/><rect x="470" y="160" width="190" height="110" rx="55"/>
        </g>
        <g stroke="var(--line)" stroke-width="1.1">
          <path id="i1" d="M270 215H334" marker-end="url(#arI)"/><path id="i2" d="M404 215H468" marker-end="url(#arI)"/><path d="M565 270V330" marker-end="url(#arI)"/>
        </g>
        <text x="20" y="80" fill="var(--muted)">host</text>
        <g fill="var(--ink)" font-size="10"><text x="56" y="166">app</text><text x="164" y="166">agent</text><text x="56" y="222">db</text><text x="164" y="222">cache</text><text x="56" y="278">observability</text></g>
        <text x="336" y="268" fill="var(--muted)">tunnel</text>
        <text x="510" y="212" fill="var(--ink)">edge</text><text x="510" y="230" fill="var(--muted)" font-size="10">dns · tls</text>
        <text x="498" y="352" fill="var(--ink)">*.behindthestack.in</text>
        <circle cx="370" cy="110" r="11" fill="var(--ink)"/><text x="366.5" y="114" fill="var(--bg)">1</text><path d="M370 121V181" stroke="var(--ink)"/>
        <text x="388" y="100" fill="var(--ink)">one tunnel token</text><text x="388" y="114" fill="var(--ink)">per app, or they collide</text>
        <path d="M20 404H660" stroke="var(--rule)"/><text x="20" y="424" fill="var(--muted)">status: running — not yet documented</text>
        <g class="pk">
          {PK.map((id, i) => (
            <circle r="3.5" class="pkt">
              <animateMotion dur={`${(2.2 + i * 0.4).toFixed(1)}s`} begin={`${(i * 0.45).toFixed(2)}s`} repeatCount="indefinite">
                <mpath href={`#${id}`} />
              </animateMotion>
            </circle>
          ))}
        </g>
      </svg>
