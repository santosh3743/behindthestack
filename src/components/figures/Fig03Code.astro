---
const PK = ['c1', 'c2', 'c3', 'c4'];
const DIALS: [string, number][] = [['security', 0.82], ['quality', 0.71], ['hygiene', 0.9], ['community', 0.58]];
const dial = (v: number, i: number) => {
  const x = 230 + i * 120, y = 400, r = 40, a0 = Math.PI, a = a0 + Math.PI * v;
  const ticks = Array.from({ length: 11 }, (_, t) => {
    const q = a0 + (Math.PI * t) / 10;
    return `M${x + Math.cos(q) * r} ${y + Math.sin(q) * r}L${x + Math.cos(q) * (r - 5)} ${y + Math.sin(q) * (r - 5)}`;
  }).join('');
  return { x, y, r, arc: `M${x - r} ${y}A${r} ${r} 0 0 1 ${x + r} ${y}`, ticks, needle: `M${x} ${y}L${x + Math.cos(a) * (r - 8)} ${y + Math.sin(a) * (r - 8)}` };
};
---
<svg viewBox="0 0 680 500" fill="none" font-family="Martian Mono, monospace" font-size="11" aria-hidden="true">
        <defs><marker id="arC" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L8 4L0 8" stroke="var(--line)" stroke-width="1.2"/></marker></defs>
        <g stroke="var(--line)" stroke-width="1.1">
          <rect x="20" y="40" width="130" height="44" stroke="var(--ink)"/>
          <path d="M44 84V320M44 124H74M44 168H74M44 212H74M74 212V292M74 252H104M74 292H104M44 320H74"/>
          <rect x="74" y="112" width="110" height="24"/><rect x="74" y="156" width="110" height="24"/><rect x="74" y="200" width="110" height="24"/>
          <rect x="104" y="240" width="96" height="24"/><rect x="104" y="280" width="96" height="24"/><rect x="74" y="308" width="110" height="24"/>
          <rect x="300" y="150" width="200" height="88" stroke="var(--ink)"/>
          <path id="c1" d="M184 124C240 124 250 170 298 180" marker-end="url(#arC)"/>
          <path id="c2" d="M200 252C250 252 256 214 298 206" marker-end="url(#arC)"/>
          <path id="c3" d="M184 320C250 320 268 236 298 226" marker-end="url(#arC)"/>
          <path id="c4" d="M400 238V300" marker-end="url(#arC)"/>
          <path d="M400 300H230V340M400 300H590V340M400 300V340"/>
        </g>
        <text x="32" y="67" fill="var(--ink)">github.com/…</text>
        <g fill="var(--muted)" font-size="10"><text x="84" y="128">deps</text><text x="84" y="172">ci</text><text x="84" y="216">src/</text><text x="114" y="256">tests</text><text x="114" y="296">secrets?</text><text x="84" y="324">issues · prs</text></g>
        <text x="300" y="140" fill="var(--muted)">open formula</text>
        <text x="318" y="190" fill="var(--ink)" font-size="13">score = Σ wᵢ · sᵢ</text>
        <text x="318" y="214" fill="var(--muted)" font-size="10">weights published, versioned</text>
        <g class="dials">
          {DIALS.map(([k, v], i) => { const d = dial(v, i); return (
            <g>
              <path d={d.arc} stroke="var(--line)" />
              <path d={d.ticks} stroke="var(--line)" />
              <path d={d.needle} stroke="var(--accent)" stroke-width="2" />
              <circle cx={d.x} cy={d.y} r="3" fill="var(--ink)" />
              <text x={d.x - d.r} y={d.y + 22} fill="var(--muted)" font-size="10">{k}</text>
              <text x={d.x - d.r} y={d.y + 38} fill="var(--ink)">{Math.round(v * 100)}</text>
            </g>
          ); })}
        </g>
        <circle cx="548" cy="72" r="11" fill="var(--ink)"/><text x="544.5" y="76" fill="var(--bg)">1</text><path d="M537 76L500 150" stroke="var(--ink)"/>
        <text x="566" y="68" fill="var(--ink)">no black box:</text><text x="566" y="82" fill="var(--ink)">read the math</text>
        <g class="pk">
          {PK.map((id, i) => (
            <circle r="3.5" class="pkt">
              <animateMotion dur={`${(2.2 + i * 0.4).toFixed(1)}s`} begin={`${(i * 0.45).toFixed(2)}s`} repeatCount="indefinite">
                <mpath href={`#${id}`} />
              </animateMotion>
            </circle>
          ))}
        </g>
      </svg>
